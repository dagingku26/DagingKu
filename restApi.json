              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test('Ada scan dan quota', function () { pm.expect(j).to.have.property('scan'); pm.expect(j).to.have.property('quota'); });"
                ]
              }
            }
          ],
          "response": []
