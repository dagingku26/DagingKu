{
  "info": {
    "name": "DagingKu API",
    "description": "Koleksi pengujian REST API DagingKu (Laravel + Sanctum). Isi tab Variables sebelum menjalankan. Header Accept: application/json ditambahkan otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://daging-ku-zeta.vercel.app/api"
    },
    {
      "key": "admin_email",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "secret"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "user_token",
      "value": ""
    },
    {
      "key": "premium_token",
      "value": ""
    },
    {
      "key": "google_id_token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Autentikasi (01-06)",
      "item": [
        {
          "name": "01. Login admin - benar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Isi variabel admin_email dan admin_password terlebih dahulu. Token disimpan otomatis ke admin_token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Ada token dan role admin', function () { pm.expect(j.token).to.be.a('string'); pm.expect(j.user.role).to.eql('admin'); });",
                  "if (j.token) { pm.collectionVariables.set('admin_token', j.token); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02. Login admin - password salah",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"password-salah-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03. Login Google - id_token valid",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Butuh id_token asli dari Google Sign-In di aplikasi (dengan webClientId yang sama dengan GOOGLE_CLIENT_ID di Laravel). Isi variabel google_id_token. Token hanya bertahan sekitar 1 jam.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('user_token', j.token); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "04. Login Google - id_token tidak valid",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"token-palsu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "05. Me - dengan token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Memakai admin_token. Jalankan request 01 lebih dulu."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Ada email', function () { pm.expect(pm.response.json().email).to.be.a('string'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "06. Me - tanpa token",
          "request": {
            "method": "GET",
            "header": [],
