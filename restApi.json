          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const j = pm.response.json();",
                  "pm.test('Field kuota lengkap', function () { ['limit','used','remaining','can_scan'].forEach(k => pm.expect(j).to.have.property(k)); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "12. Catat scan - kuota tersedia",
